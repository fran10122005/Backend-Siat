# ============================
# SIAT Backend - Configuración
# ============================

# Puerto del servidor
PORT=3000

# Entorno: development | production | test
NODE_ENV=development

# Base de datos (Neon PostgreSQL)
# Copia este archivo a .env y reemplaza los valores por los reales.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

# Conexión DIRECTA a Neon (SIN el sufijo -pooler) que usa Prisma Migrate.
# El -pooler de Neon no soporta advisory locks, por lo que las migraciones
# DEBEN ejecutarse contra la conexión directa. La app en runtime sigue usando
# DATABASE_URL (con pooler). Obtén el host directo desde Neon → Connection Details.
DIRECT_URL="postgresql://USER:PASSWORD@HOST_DERECTO:5432/DBNAME?sslmode=require"

# JWT: genera un secreto seguro con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="genera_un_secreto_seguro_aqui"

# URL del frontend (localhost en dev, Netlify en producción)
FRONTEND_URL=http://localhost:5173

# === CONFIGURACIÓN DE CORREOS (EMAILJS) ===
# Crea una cuenta en https://dashboard.emailjs.com, un servicio SMTP/Gmail y una plantilla.
# En el dashboard de la plantilla pega el contenido de emailjs/EMAILJS_DASHBOARD_TEMPLATE.html
# y usa el asunto {{subject}} con el destinatario {{to_email}}.
EMAILJS_SERVICE_ID=service_XXXXXXX
EMAILJS_TEMPLATE_ID=template_XXXXXXX
EMAILJS_PUBLIC_KEY=TU_PUBLIC_KEY_AQUI
EMAILJS_PRIVATE_KEY=TU_PRIVATE_KEY_AQUI

# === WEB AUTHN (Acceso rápido por huella) ===
# RP_ID = dominio donde corre el frontend (ej. localhost o tu dominio).
# Solo se usan si el frontend corre en un dominio distinto al esperado.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=SIAT
WEBAUTHN_ORIGIN=http://localhost:5173
