# ============================
# SIAT Backend - Configuración
# ============================

# Puerto del servidor
PORT=3000

# Entorno: development | production | test
NODE_ENV=development

# Base de datos (Neon PostgreSQL)
# Copia este archivo a .env y reemplaza los valores por los reales.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

# JWT: genera un secreto seguro con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="genera_un_secreto_seguro_aqui"

# URL del frontend (localhost en dev, Netlify en producción)
FRONTEND_URL=http://localhost:5173

# === CONFIGURACIÓN DE CORREOS (NODEMAILER) ===
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# === WEB AUTHN (Acceso rápido por huella) ===
# RP_ID = dominio donde corre el frontend (ej. localhost o tu dominio).
# Solo se usan si el frontend corre en un dominio distinto al esperado.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=SIAT
WEBAUTHN_ORIGIN=http://localhost:5173
