<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="x-apple-disable-message-reformatting">
  <title>SIAT</title>
  <style>
    body {
      margin: 0;
      padding: 0;
      background-color: #eef2f7;
      font-family: 'Segoe UI', -apple-system, BlinkMacSystemFont, Roboto, Helvetica, Arial, sans-serif;
      color: #1e293b;
      -webkit-font-smoothing: antialiased;
    }
    .container {
      max-width: 600px;
      margin: 32px auto;
      background-color: #ffffff;
      border-radius: 16px;
      overflow: hidden;
      box-shadow: 0 8px 24px rgba(15, 42, 74, 0.08);
    }
    .header {
      background: linear-gradient(135deg, #0b2d52 0%, #14406e 55%, #155e75 100%);
      padding: 34px 28px 28px;
      text-align: center;
    }
    .logo-badge {
      display: inline-block;
      background: rgba(255, 255, 255, 0.12);
      border: 1px solid rgba(255, 255, 255, 0.35);
      border-radius: 10px;
      padding: 8px 22px;
      font-size: 28px;
      font-weight: 800;
      letter-spacing: 4px;
      color: #ffffff;
      line-height: 1.2;
    }
    .tagline {
      margin-top: 10px;
      font-size: 12px;
      letter-spacing: 2px;
      text-transform: uppercase;
      color: #9ad0e8;
    }
    .body {
      padding: 36px 32px;
      line-height: 1.65;
      font-size: 15px;
    }
    .footer {
      background-color: #f8fafc;
      padding: 22px 24px;
      text-align: center;
      font-size: 12px;
      color: #94a3b8;
      border-top: 1px solid #e2e8f0;
      line-height: 1.7;
    }
    .footer a {
      color: #0ea5e9;
      text-decoration: none;
    }
    @media (max-width: 620px) {
      .body { padding: 26px 20px; }
      .header { padding: 26px 16px 22px; }
      .container { margin: 16px; }
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <!--
        EmailJS no soporta adjuntos CID. Para mostrar el logo real,
        sube Logo.png a Cloudinary y reemplaza el contenido de .logo-badge
        por: <img src="https://res.cloudinary.com/..." alt="SIAT" style="height:44px;"/>
      -->
      <div class="logo-badge">SIAT</div>
      <div class="tagline">Sistema de Inteligencia Artificial Temprana</div>
    </div>
    <div class="body">
      {{{body}}}
    </div>
    <div class="footer">
      <p style="margin:0 0 6px 0;">&copy; {{currentYear}} SIAT &mdash; Sistema de Inteligencia Artificial Temprana. Todos los derechos reservados.</p>
      <p style="margin:0;">Este es un correo generado automáticamente. Por favor, no respondas a este mensaje.</p>
    </div>
  </div>
</body>
</html>
